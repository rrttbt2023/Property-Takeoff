# Keep these blank in Vercel so the same-origin /api proxy is used.
VITE_API_BASE_URL=
VITE_SHARED_API_BASE_URL=

# Public browser keys. Restrict each key to the production domain in its provider dashboard.
VITE_MAPTILER_KEY=
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_API_KEY=
VITE_AZURE_MAPS_KEY=
VITE_TURNSTILE_SITE_KEY=

VITE_ENABLE_AI=true
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
