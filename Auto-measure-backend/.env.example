# Runtime
AUTO_MEASURE_ENV=production
AUTO_MEASURE_APP_URL=https://mckennasitemanagement.vercel.app
AUTO_MEASURE_CORS_ALLOW_ORIGINS=https://mckennasitemanagement.vercel.app

# Managed PostgreSQL is required by /api/ready in production.
AUTO_MEASURE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/property_takeoff

# Local-development fallbacks only. Public production should use PostgreSQL + S3/R2.
AUTO_MEASURE_DB_PATH=./data/measurements.db
AUTO_MEASURE_PRIVATE_UPLOAD_DIR=./data/private_uploads
AUTO_MEASURE_STORAGE_BACKEND=s3
AUTO_MEASURE_S3_BUCKET=property-takeoff-private
AUTO_MEASURE_S3_REGION=us-east-1
AUTO_MEASURE_S3_ENDPOINT_URL=
AUTO_MEASURE_S3_ACCESS_KEY_ID=replace-me
AUTO_MEASURE_S3_SECRET_ACCESS_KEY=replace-me
AUTO_MEASURE_S3_USE_IAM_ROLE=false
AUTO_MEASURE_S3_SERVER_SIDE_ENCRYPTION=AES256
AUTO_MEASURE_UPLOAD_SCAN_MODE=required
AUTO_MEASURE_CLAMSCAN_COMMAND=clamscan
AUTO_MEASURE_BACKUPS_CONFIGURED=true
AUTO_MEASURE_MANAGED_DATABASE_BACKUPS=false
AUTO_MEASURE_BACKUP_DIR=/tmp/property-takeoff-backups
AUTO_MEASURE_BACKUP_S3_BUCKET=property-takeoff-backups
AUTO_MEASURE_BACKUP_S3_PREFIX=database
AUTO_MEASURE_BACKUP_S3_REGION=us-east-1
AUTO_MEASURE_BACKUP_S3_ENDPOINT_URL=
AUTO_MEASURE_BACKUP_S3_ACCESS_KEY_ID=replace-me
AUTO_MEASURE_BACKUP_S3_SECRET_ACCESS_KEY=replace-me
AUTO_MEASURE_BACKUP_S3_USE_IAM_ROLE=false
AUTO_MEASURE_BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
AUTO_MEASURE_BACKUP_LOCAL_RETENTION_DAYS=14

# Existing McKenna staff login. Prefer AUTO_MEASURE_SHARED_AUTH_USERS_JSON for multiple staff.
AUTO_MEASURE_SHARED_AUTH_USERS_JSON={"staff@example.com":"replace-with-a-long-password"}
AUTO_MEASURE_SHARED_AUTH_TTL_HOURS=168
AUTO_MEASURE_PASSWORD_PEPPER=replace-with-a-random-64-character-secret
AUTO_MEASURE_CSRF_SECRET=replace-with-a-different-random-64-character-secret
AUTO_MEASURE_ALLOW_PUBLIC_SIGNUP=true
AUTO_MEASURE_REQUIRE_EMAIL_VERIFICATION=true
AUTO_MEASURE_REQUIRE_STAFF_MFA=true
AUTO_MEASURE_REQUIRE_AI_AUTH=true
AUTO_MEASURE_LEGAL_VERSION=2026-11-19

# Cloudflare Turnstile registration protection.
AUTO_MEASURE_TURNSTILE_SECRET_KEY=replace-me

# Transactional email. Any SMTP provider can be used.
AUTO_MEASURE_SMTP_HOST=smtp.example.com
AUTO_MEASURE_SMTP_PORT=587
AUTO_MEASURE_SMTP_USERNAME=replace-me
AUTO_MEASURE_SMTP_PASSWORD=replace-me
AUTO_MEASURE_SMTP_SSL=false
AUTO_MEASURE_EMAIL_FROM=support@mckennasitemanagement.com

# Error monitoring and alerting.
SENTRY_DSN=https://replace-me@sentry.io/project
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe Billing. Use sandbox values first, then replace with live-mode values at launch.
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_BASIC_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX=false
STRIPE_REQUIRE_TERMS_ACCEPTANCE=true
