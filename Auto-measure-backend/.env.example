# Runtime
AUTO_MEASURE_ENV=production
AUTO_MEASURE_APP_URL=https://mckennasitemanagement.vercel.app
AUTO_MEASURE_CORS_ALLOW_ORIGINS=https://mckennasitemanagement.vercel.app

# Render persistent disk paths. Do not use ephemeral storage in production.
AUTO_MEASURE_DB_PATH=/var/data/property-takeoff/measurements.db
AUTO_MEASURE_PRIVATE_UPLOAD_DIR=/var/data/property-takeoff/private_uploads

# Existing McKenna staff login. Prefer AUTO_MEASURE_SHARED_AUTH_USERS_JSON for multiple staff.
AUTO_MEASURE_SHARED_AUTH_USERS_JSON={"staff@example.com":"replace-with-a-long-password"}
AUTO_MEASURE_SHARED_AUTH_TTL_HOURS=168
AUTO_MEASURE_PASSWORD_PEPPER=replace-with-a-random-64-character-secret
AUTO_MEASURE_ALLOW_PUBLIC_SIGNUP=true
AUTO_MEASURE_REQUIRE_AI_AUTH=true

# Stripe Billing. Use sandbox values first, then replace with live-mode values at launch.
STRIPE_RESTRICTED_KEY=rk_test_replace_me
STRIPE_BASIC_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
